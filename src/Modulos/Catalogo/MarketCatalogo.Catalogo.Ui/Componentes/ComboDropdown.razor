@using MarketCatalogo.Catalogo.Contratos
@using MarketCatalogo.Catalogo.Ui

@* Combo: dropdown flotante en la toolbar de la grilla (junto a Sucursal), en desktop Y en mobile —
   siempre acá, nunca en el panel/drawer de filtros: es el más usado de los dos, así que se
   mantiene siempre a un tap en vez de un nivel más adentro.

   Checkbox oculto + <label> de fondo transparente que lo cierra al tocar afuera, en vez de
   <details>: mismo patrón que ya usa el drawer de filtros (mk-filtros-check/mk-filtros-backdrop),
   sin sumar una línea de JavaScript. Se abre solo si ya hay un precio tildado, para que el filtro
   activo no quede escondido al recargar.

   Es una faceta de DOS niveles: cantidad de unidades ("Combo de 2", "Combo de 10"...) y, adentro,
   el precio de cada tramo ("2 x $15.000"...). El nivel 1 es sólo un <details> nativo que expande o
   contrae — no filtra nada por sí solo — el filtro real está en las opciones de precio de adentro. *@

@if (Opciones.Count > 0)
{
    <div class="mk-combo-dropdown">
        <input type="checkbox" id="mk-combo-toggle" class="mk-combo-toggle-check" checked="@(Activos > 0)" />

        <label for="mk-combo-toggle" class="mk-combo-dropdown-boton">
            <span class="mk-rotulo">Combo</span>
            @if (Activos > 0)
            {
                <span class="mk-combo-dropdown-contador">@Activos</span>
            }
        </label>

        @* Cubre toda la pantalla mientras está abierto; tocar cualquier punto afuera del panel
           cae acá y cierra el dropdown (es el mismo <label for>, así que "toca" el checkbox). *@
        <label for="mk-combo-toggle" class="mk-combo-dropdown-backdrop" aria-hidden="true"></label>

        <div class="mk-combo-dropdown-panel">
            <ul class="mk-faceta-combo-grupos">
                @foreach (var g in Opciones)
                {
                    <li>
                        <details open="@g.TieneActivo">
                            <summary>
                                <span class="mk-faceta-nombre">@g.Etiqueta</span>
                                <span class="mk-faceta-cantidad">@g.Cantidad</span>
                            </summary>
                            <ul class="mk-faceta-combo-detalles">
                                @foreach (var d in g.Detalles)
                                {
                                    <li>
                                        <a class="mk-faceta-opcion @(d.Activa ? "activa" : "")"
                                           href="@UrlCatalogo.Alternar(Filtros, "combo", d.Valor, d.Activa)">
                                            <span class="mk-faceta-marca" aria-hidden="true"></span>
                                            <span class="mk-faceta-nombre">@d.Etiqueta</span>
                                            <span class="mk-faceta-cantidad">@d.Cantidad</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<OpcionFacetaCombo> Opciones { get; set; }
    [Parameter, EditorRequired] public required FiltrosCatalogo Filtros { get; set; }

    private int Activos => Opciones.Sum(g => g.Detalles.Count(d => d.Activa));
}
