@page "/proveedor"
@attribute [Authorize(Policy = PoliticasAuth.Proveedor)]
@inject IPortalProveedores Portal

@* Pantalla de entrada del proveedor: sus órdenes vigentes, UNA FILA POR ORDEN a lo ancho, con las fotos
   chiquitas de sus artículos. La foto grande vive adentro de la orden (una card por artículo): acá se
   busca la orden, allá se elige qué imprimir.
   El código de proveedor NO se toma de la URL: sale del claim de la identidad. *@

<PageTitle>Mis órdenes - MARKET</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="mk-portal">

    <header class="mk-portal-head">
        <h1>Mis órdenes</h1>
        <p class="mk-portal-sub">
            Acá podés imprimir etiquetas de refuerzo si las que te mandamos no alcanzan.
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Mensaje))
    {
        <p class="mk-portal-aviso" role="alert">@Mensaje</p>
    }

    @* La impresora define el lenguaje y la resolución con la que se arma la etiqueta: sin esto no se
       puede imprimir, porque un ZPL de 203 dpi sale corrido en una de 300. *@
    <form class="mk-portal-impresora" method="post" action="/proveedor/impresora">
        <AntiforgeryToken />
        <label for="imp">Mi impresora</label>
        <select id="imp" name="impresora">
            @foreach (var i in IPortalProveedores.Impresoras)
            {
                <option value="@i.Clave" selected="@(_impresora?.Clave == i.Clave)">@i.Etiqueta</option>
            }
        </select>
        <button type="submit">Guardar</button>
        @if (_impresora is null)
        {
            <span class="mk-portal-falta">Elegí tu impresora antes de imprimir.</span>
        }
    </form>

    @if (_lista is null)
    {
        <p class="mk-portal-vacio">Cargando…</p>
    }
    else if (!_lista.Disponible)
    {
        <p class="mk-portal-aviso" role="alert">
            No pudimos traer tus órdenes en este momento. Volvé a probar en unos minutos; si sigue igual,
            avisanos.
        </p>
    }
    else if (_lista.Ordenes.Count == 0 && _lista.SinNadaParaImprimir > 0)
    {
        @* Tiene órdenes, pero ninguna con curva cargada. Decirle "no tenés órdenes" sería mentirle, y
           además taparía un problema nuestro: si el cálculo de la curva falla, vuelven todas en cero. *@
        <p class="mk-portal-vacio">
            Tenés @_lista.SinNadaParaImprimir @(_lista.SinNadaParaImprimir == 1 ? "orden" : "órdenes") en curso,
            pero todavía ninguna tiene etiquetas para imprimir. Cuando carguemos la curva las vas a ver acá.
        </p>
    }
    else if (_lista.Ordenes.Count == 0)
    {
        <p class="mk-portal-vacio">No tenés órdenes en curso.</p>
    }
    else
    {
        <div class="mk-portal-filas">
            @foreach (var o in _lista.Ordenes)
            {
                var arts = o.Renglones;
                <a class="mk-portal-fila" href="@($"/proveedor/orden/{o.NroOrden}")">

                    @* Las fotos que entran, y un "+N" con el resto. Casi todas las OP traen una sola prenda;
                       la excepción (hay una con 21) no puede estirar la fila. *@
                    <div class="mk-portal-fila-fotos">
                        @foreach (var r in arts.Take(MaxMiniaturas))
                        {
                            <span class="mk-portal-mini" title="@r.ArtCod">
                                @if (_conFoto.Contains(r.ArtCod))
                                {
                                    <img src="@($"/proveedor/foto/{r.ArtCod}_160.webp")" alt="@r.ArtCod"
                                         loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="mk-portal-sinfoto">Sin foto</span>
                                }
                            </span>
                        }
                        @if (arts.Count > MaxMiniaturas)
                        {
                            <span class="mk-portal-mini mk-portal-mini-mas">+@(arts.Count - MaxMiniaturas)</span>
                        }
                    </div>

                    <div class="mk-portal-fila-info">
                        <p class="mk-portal-fila-orden">
                            Orden <b>@o.NroOrden</b>
                            <span class="mk-portal-fila-estado">@o.Estado</span>
                        </p>

                        @if (arts.Count == 1)
                        {
                            var a = arts[0];
                            <p class="mk-portal-fila-cod">@a.ArtCod</p>
                            @* El código con el que el proveedor llama a esa prenda: es por el que busca él,
                               así que va en su propio renglón y siempre, aunque nadie lo haya cargado. *@
                            <p class="mk-portal-fila-codprov">Tu código: <b>@CodProv(a.CodigoProveedor)</b></p>
                            <p class="mk-portal-fila-des">@a.Descripcion</p>
                        }
                        else
                        {
                            <p class="mk-portal-fila-cod">@arts.Count artículos</p>
                            <p class="mk-portal-fila-codprov">Tus códigos: <b>@Codigos(arts, r => CodProv(r.CodigoProveedor))</b></p>
                            <p class="mk-portal-fila-des">@Codigos(arts, r => r.ArtCod)</p>
                        }
                    </div>

                    <dl class="mk-portal-fila-datos">
                        <div>
                            <dt>Te mandamos</dt>
                            <dd>@Enviadas(o)</dd>
                        </div>
                        <div>
                            <dt>Imprimiste</dt>
                            <dd>@o.Renglones.Sum(r => r.EtiquetasImpresasPortal).ToString("N0")</dd>
                        </div>
                    </dl>

                    <span class="mk-portal-fila-ir">Ver e imprimir</span>
                </a>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Mensaje { get; set; }

    // Cuántas miniaturas por fila antes del "+N". Con 4 entra también en un celular.
    private const int MaxMiniaturas = 4;

    private PortalListaOrdenes? _lista;
    private PortalImpresora? _impresora;
    private IReadOnlySet<string> _conFoto = new HashSet<string>();

    protected override async Task OnInitializedAsync()
    {
        var cod = await CodProveedor();
        if (string.IsNullOrEmpty(cod)) { _lista = new(true, []); return; }
        _impresora = await Portal.ImpresoraAsync(cod);
        _lista = await Portal.OrdenesAsync(cod);
        // Sólo se pregunta por las miniaturas que se van a dibujar.
        _conFoto = await Portal.ConFotoAsync(
            _lista.Ordenes.SelectMany(o => o.Renglones.Take(MaxMiniaturas)).Select(r => r.ArtCod).ToList());
    }

    private async Task<string?> CodProveedor()
    {
        if (AuthState is null) return null;
        var u = (await AuthState).User;
        return u.FindFirst(PoliticasAuth.ClaimCodProveedor)?.Value;
    }

    // En una OP con varias prendas, los primeros códigos y "y N más": la fila tiene que seguir siendo una fila.
    // Sirve para los nuestros y para los del proveedor (mismo orden, así se corresponden).
    private static string Codigos(IReadOnlyList<PortalRenglon> arts, Func<PortalRenglon, string> codigo)
    {
        const int muestra = 3;
        var primeros = string.Join(" · ", arts.Take(muestra).Select(codigo));
        return arts.Count > muestra ? $"{primeros} y {arts.Count - muestra} más" : primeros;
    }

    // El código del proveedor se muestra siempre: si no está cargado, un guión — mejor que esconder la línea
    // y que no sepa que el dato existe.
    private static string CodProv(string? c) => string.IsNullOrWhiteSpace(c) ? "—" : c.Trim();

    // Lo que se le mandó impreso desde acá. Es informativo: NO descuenta del tope (el portal existe
    // justamente para cuando eso no alcanzó).
    private static string Enviadas(PortalOrden o)
    {
        var total = o.Renglones.Sum(r => r.EtiquetasEnviadas ?? 0);
        if (total == 0) return "—";
        var fecha = o.Renglones.Where(r => r.FechaEnvioEtiquetas is not null)
                               .Select(r => r.FechaEnvioEtiquetas!.Value).DefaultIfEmpty().Max();
        return fecha == default ? total.ToString("N0") : $"{total:N0} el {fecha:dd/MM}";
    }
}
