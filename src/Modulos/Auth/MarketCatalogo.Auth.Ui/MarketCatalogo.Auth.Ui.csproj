<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- UI del módulo Auth: la pantalla de login (Razor Class Library, descubierta por el host vía
       AdditionalAssemblies). Hace POST/GET a los endpoints /auth/* del host; del módulo Auth usa sólo
       PoliticasAuth (los nombres de los claims), para mandar a cada perfil a su pantalla cuando ya hay
       sesión. Monocromática (Manual de Marca). -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketCatalogo.Auth\MarketCatalogo.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.15" />
  </ItemGroup>

</Project>
