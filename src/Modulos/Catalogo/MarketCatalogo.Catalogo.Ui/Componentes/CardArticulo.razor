@using MarketCatalogo.Catalogo.Contratos

@* Card de la grilla. Trae lo mínimo: foto, título, precio y disponibilidad.
   Talles y colores NO van acá — serían ~14 filas de variantes por artículo para no mostrar nada
   útil en la grilla. Van en la ficha. *@

@* data-enhance-nav="false": la ficha abre con navegación REAL (no la mejorada de Blazor). Así, al
   volver atrás, el navegador restaura esta grilla desde su back-forward cache EXACTAMENTE como estaba
   —posición de scroll y todos los artículos cargados por el scroll infinito— sin pedir nada ni correr
   JS. La navegación mejorada interceptaba el volver y rompía eso (caías al principio / a una página
   suelta). Es lo más eficiente: restauración nativa e instantánea. *@
<a class="mk-card" href="/producto/@Articulo.Slug" data-enhance-nav="false">
    <div class="mk-card-foto">
        @if (Articulo.TieneFoto)
        {
            @* width/height fijos para que la grilla no salte mientras cargan (layout shift).
               srcset deja que un celular retina baje la de 1200 para el mismo hueco. *@
            <img class="mk-foto"
                 src="/fotos/@(Articulo.ArtCod)_400.webp?v=@Articulo.FotoVersion"
                 srcset="/fotos/@(Articulo.ArtCod)_400.webp?v=@Articulo.FotoVersion 400w, /fotos/@(Articulo.ArtCod)_1200.webp?v=@Articulo.FotoVersion 1200w"
                 sizes="(max-width: 640px) 50vw, 300px"
                 width="400" height="600"
                 loading="lazy" decoding="async"
                 alt="@Articulo.Titulo" />
        }
        else
        {
            @* Placeholder de los ~303 sin foto. Rectángulo liso: en un diseño monocromático se lee
               como "todavía no hay foto" sin parecer un error. Nada de iconos de imagen rota. *@
            <div class="mk-card-sinfoto" aria-label="Sin foto todavía"></div>
        }
    </div>

    <div class="mk-card-datos">
        <h3 class="mk-card-titulo">@Articulo.Titulo</h3>

        @if (Articulo.ComboTexto is not null)
        {
            <p class="mk-card-combo">@Articulo.ComboTexto</p>
        }
        @if (Articulo.PrecioSueltaTexto is not null)
        {
            <p class="mk-card-unidad">@Articulo.PrecioSueltaTexto la unidad</p>
        }

        @if (Articulo.Locales.Count > 0)
        {
            <p class="mk-rotulo mk-card-locales">@string.Join(" · ", Articulo.Locales)</p>
        }
    </div>
</a>

@code {
    [Parameter, EditorRequired] public required ArticuloDto Articulo { get; set; }
}
