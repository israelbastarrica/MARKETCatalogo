@using MarketCatalogo.Catalogo.Contratos.Interno

@* Card del catálogo INTERNO. Dos formas:
   · GESTIÓN (ADMIN, Completo=true): foto + badges + código + datos de gestión (costo, margen teórico,
     proveedor/marca/temporada, si está publicado).
   · Resto del staff (Completo=false): EXACTAMENTE la card pública (mismas clases mk-card-*), para que la
     grilla interna se vea igual que el catálogo público. La única diferencia invisible es el link, que va
     a la ficha interna reducida (así los artículos de depósito/no publicados también abren).
   La foto la sirve el endpoint /fotos con permiso interno (también las de artículos no publicados). *@

@if (!Completo)
{
    @* ===== Card pública (idéntica a CardArticulo) ===== *@
    <a class="mk-card" href="@Url" data-enhance-nav="false">
        <div class="mk-card-foto">
            @if (Articulo.TieneFoto)
            {
                <img class="mk-foto"
                     src="/fotos/@(Articulo.Codigo)_400.webp?v=@Articulo.FotoVersion"
                     srcset="/fotos/@(Articulo.Codigo)_400.webp?v=@Articulo.FotoVersion 400w, /fotos/@(Articulo.Codigo)_1200.webp?v=@Articulo.FotoVersion 1200w"
                     sizes="(max-width: 640px) 50vw, 300px"
                     width="400" height="600"
                     loading="lazy" decoding="async"
                     alt="@Articulo.Descripcion" />
            }
            else
            {
                <div class="mk-card-sinfoto" aria-label="Sin foto todavía"></div>
            }

            <div class="mk-card-talles" aria-hidden="true">
                @if (Articulo.Talles.Count > 0)
                {
                    @foreach (var talle in Articulo.Talles)
                    {
                        <span class="mk-card-talle">@talle</span>
                    }
                }
                else
                {
                    <span class="mk-card-talle mk-card-talle-unico">Talle único</span>
                }
            </div>
        </div>

        <div class="mk-card-datos">
            <h3 class="mk-card-titulo">@Articulo.Descripcion</h3>

            @if (Articulo.ComboTexto is not null)
            {
                <p class="mk-card-combo">@Articulo.ComboTexto</p>
            }
            @if (Articulo.PrecioVenta is decimal pv)
            {
                <p class="mk-card-unidad">@Plata(pv) la unidad</p>
            }

            @{ var locales = Locales(); }
            @if (locales.Count > 0)
            {
                <p class="mk-rotulo mk-card-locales">@string.Join(" · ", locales)</p>
            }
        </div>
    </a>
}
else
{
    @* ===== Card de gestión (ADMIN) ===== *@
    <a class="mk-ic @(Articulo.Publicado ? "" : "mk-ic-oculto")" href="@Url" data-enhance-nav="false">
        <div class="mk-ic-foto">
            @if (Articulo.TieneFoto)
            {
                <img class="mk-foto"
                     src="/fotos/@(Articulo.Codigo)_400.webp?v=@Articulo.FotoVersion"
                     width="400" height="600" loading="lazy" decoding="async" alt="@Articulo.Descripcion" />
            }
            else
            {
                <div class="mk-card-sinfoto" aria-label="Sin foto"></div>
            }

            <div class="mk-ic-badges">
                @if (Articulo.EnLuro) { <span class="mk-ic-badge">Luro</span> }
                @if (Articulo.EnPeralta) { <span class="mk-ic-badge">Peralta</span> }
                @if (Articulo.EnDeposito) { <span class="mk-ic-badge mk-ic-badge-depo">Depósito</span> }
            </div>

            @* Curva de talles al pasar el mouse (sólo hover real; en touch no se muestra). Mismo overlay
               que la card pública. Sin talles reales = talle único. *@
            <div class="mk-card-talles" aria-hidden="true">
                @if (Articulo.Talles.Count > 0)
                {
                    @foreach (var talle in Articulo.Talles)
                    {
                        <span class="mk-card-talle">@talle</span>
                    }
                }
                else
                {
                    <span class="mk-card-talle mk-card-talle-unico">Talle único</span>
                }
            </div>
        </div>

        <div class="mk-ic-datos">
            <h3 class="mk-ic-titulo">@Articulo.Descripcion</h3>
            <p class="mk-ic-cod mk-rotulo">@Articulo.Codigo</p>

            @* Precios apilados, igual que la card pública: combo en negrita arriba, precio unitario gris
               abajo ("la unidad"). Sin combo, sólo el precio suelto. *@
            <div class="mk-ic-precios">
                @if (Articulo.ComboTexto is not null)
                {
                    <p class="mk-ic-combo">@Articulo.ComboTexto</p>
                }
                @if (Articulo.PrecioUnidadCombo is decimal pu)
                {
                    <p class="mk-ic-venta">@Plata(pu) la unidad</p>
                }
                else if (Articulo.PrecioVenta is decimal pv)
                {
                    <p class="mk-ic-venta">@Plata(pv)</p>
                }
            </div>

            <dl class="mk-ic-gestion">
                <div><dt>Costo</dt><dd>@(Articulo.PrecioCompra is decimal c ? Plata(c) : "—")</dd></div>
                <div><dt>Margen</dt><dd>@(Articulo.MargenTeorico is decimal m ? $"{m:0.#}%" : "—")</dd></div>
            </dl>

            @if (Meta().Any())
            {
                <p class="mk-ic-meta mk-rotulo">@string.Join(" · ", Meta())</p>
            }
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired] public required ArticuloInternoDto Articulo { get; set; }

    /// <summary>Vista de gestión (perfil ADMIN): card interna con badges, código, costo/margen y meta. Si es
    /// false, la card se renderiza EXACTAMENTE como la pública. La grilla lo decide una vez y lo baja a todas.</summary>
    [Parameter] public bool Completo { get; set; } = true;

    /// <summary>El listado del que sale esta card, como query string ya armado (<c>UrlInterno.Contexto</c>):
    /// viaja colgado del link para que la ficha sepa dentro de qué listado está y pueda ofrecer
    /// Anterior/Siguiente. Vacío = se entró sin filtros (la ficha recorre el catálogo completo). La grilla lo
    /// calcula UNA vez y se lo baja igual a todas las cards.</summary>
    [Parameter] public string? Contexto { get; set; }

    // Link a la ficha con el contexto ya pegado. Las dos formas de la card apuntan al mismo lado.
    private string Url => $"/interno/producto/{Articulo.Codigo}{Contexto}";

    // Locales donde está armado, igual que el público (ArticuloDto.Locales): MAYÚSCULAS, sólo tiendas
    // (Luro/Peralta), sin depósito. Para la card reducida.
    private IReadOnlyList<string> Locales()
    {
        var l = new List<string>(2);
        if (Articulo.EnLuro) l.Add("LURO");
        if (Articulo.EnPeralta) l.Add("PERALTA");
        return l;
    }

    private IEnumerable<string> Meta()
    {
        if (!string.IsNullOrWhiteSpace(Articulo.Proveedor)) yield return Articulo.Proveedor!;
        if (!string.IsNullOrWhiteSpace(Articulo.Marca)) yield return Articulo.Marca!;
        if (!string.IsNullOrWhiteSpace(Articulo.Temporada)) yield return Articulo.Temporada!;
        // El año de la prenda (ART.ANO en Dragon, materializado en dbo.Catalogo). Va ÚLTIMO y pegado a
        // Temporada porque juntos son una sola idea: "Prim-Ver · 2026". Invariant para que salga "2026" y
        // no "2.026" — es un año, no una cantidad.
        if (Articulo.Anio is int anio) yield return anio.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    // Moneda argentina sin decimales ni símbolo (misma decisión de marca que el público, = Combo.Plata).
    private static string Plata(decimal monto)
        => monto.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
