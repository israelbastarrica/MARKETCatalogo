@using MarketCatalogo.Catalogo.Contratos
@using MarketCatalogo.Catalogo.Contratos.Interno
@using MarketCatalogo.Catalogo.Ui
@using MarketCatalogo.Auth.Contratos
@inject ICatalogoConsulta CatalogoConsulta
@inject ICatalogoInternoConsulta CatalogoInterno

@* Nav del sitio. SSR puro, cero JavaScript.

   Según el usuario: si NO hay staff logueado, el mega-menú lleva al catálogo PÚBLICO (sólo Indumentaria
   publicada). Si hay staff logueado, TODO es interno: los géneros abarcan el universo completo (todos los
   rubros: Accesorios, Lencería, Calzado…) y linkean a la grilla interna /interno.

   DESKTOP: mega-menú por GÉNEROS (Mujer, Hombre, Niños…); al pasar el mouse se despliegan los TIPOS.
   CELULAR: los géneros se ocultan (van al drawer de filtros); queda el link "Catálogo" como entrada.

   PROVEEDOR: nada de todo esto. Entró a hacer una cosa (imprimir etiquetas de sus órdenes) y el menú de
   la tienda no lo ayuda; en su lugar el header dice dónde está. *@

<nav class="mk-nav">

    @if (_proveedor)
    {
        <a class="mk-nav-link mk-nav-portal" href="/proveedor">Portal proveedores</a>
    }
    else
    {

    <NavLink class="mk-nav-link mk-nav-catalogo" href="@(_interno ? "interno" : "catalogo")" Match="NavLinkMatch.All">Catálogo</NavLink>

    @foreach (var s in _secciones)
    {
        <div class="mk-mega">
            <button type="button" class="mk-nav-link mk-mega-sum" aria-haspopup="true">@s.Nombre</button>
            <div class="mk-mega-panel">
                <ul class="mk-mega-lista">
                    @foreach (var t in s.Tipos)
                    {
                        <li>
                            <a class="mk-mega-item" href="@t.Href">
                                <span>@t.Nombre</span>
                                <span class="mk-mega-cant">@t.Cantidad</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (_interno)
    {
        @* Logueado = todo interno: en vez de Nosotros/Noticias, el buscador por código/nombre. *@
        <form class="mk-nav-buscar" method="get" action="/interno" role="search">
            <input name="q" placeholder="Código, nombre, proveedor…" aria-label="Buscar en el catálogo interno" />
            @* Cruz para borrar lo escrito: un type="reset" (el input no tiene value inicial, así que lo deja
               vacío) — anda sin JS. Sólo se ve con texto (CSS :placeholder-shown). El onclick es mejora: le
               devuelve el foco al input para seguir escribiendo. *@
            <button type="reset" class="mk-nav-buscar-borrar" aria-label="Borrar búsqueda" title="Borrar"
                    onclick="this.form.q.focus()">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <line x1="6" y1="6" x2="18" y2="18" />
                    <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
            </button>
            <button type="submit" aria-label="Buscar">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="21" y2="21" />
                </svg>
            </button>
        </form>
    }
    else
    {
        <NavLink class="mk-nav-link" href="nosotros">Nosotros</NavLink>
        <NavLink class="mk-nav-link" href="noticias">Noticias</NavLink>
    }

    }

</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<SeccionNav> _secciones = [];
    private bool _interno;
    private bool _proveedor;

    protected override async Task OnInitializedAsync()
    {
        // ¿Staff logueado y aprobado? Entonces todo el header apunta al catálogo interno.
        if (AuthState is not null)
        {
            var usuario = (await AuthState).User;
            _interno = PoliticasAuth.EsStaffAprobado(usuario);
            _proveedor = usuario.HasClaim(PoliticasAuth.ClaimEstado, PoliticasAuth.EstadoOk)
                         && PoliticasAuth.EsProveedor(usuario);
        }

        // El proveedor no ve el mega-menú, así que tampoco hace falta ir a buscar los géneros.
        if (_proveedor) return;

        try
        {
            if (_interno)
            {
                var menu = await CatalogoInterno.MenuAsync();
                _secciones = MenuSecciones.ConstruirInterno(menu);
            }
            else
            {
                var snap = await CatalogoConsulta.SnapshotAsync();
                _secciones = MenuSecciones.Construir(snap.Menu);
            }
        }
        catch
        {
            // Arranque en frío sin datos: la barra queda con los links planos, sin géneros.
            _secciones = [];
        }
    }
}
